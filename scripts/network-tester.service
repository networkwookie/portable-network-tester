[Unit]
Description=Portable Network Tester
After=graphical.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/network-tester
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/pi/.Xauthority"
ExecStart=/opt/network-tester/venv/bin/python /opt/network-tester/src/main.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical.target
