[Unit]
Description=Portable Network Tester
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/portable-network-tester
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/pi/.Xauthority"
ExecStart=/home/pi/portable-network-tester/venv/bin/python /home/pi/portable-network-tester/src/main.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
